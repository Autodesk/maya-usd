<!--
Pixel graph of Gaussian splats. No lighting: the color written by the geometry stage goes to
the premultiplied outSurfaceFinal through mayaComputeSurfaceFinal. The geometry stage is added
with addInputFragment("GaussianSplatGeometry", "GPUStage", "GPUStage").
-->
<fragment_graph name="GaussianSplatShader" ref="GaussianSplatShader" class="FragmentGraph" version="1.0" feature_level="0" >
    <fragments>
        <fragment_ref name="mayaSurfaceShaderOutput" ref="mayaSurfaceShaderOutput" />
        <fragment_ref name="mayaComputeSurfaceFinal" ref="mayaComputeSurfaceFinal" />
        <fragment_ref name="GaussianSplatPixel" ref="GaussianSplatPixel" />
        <fragment_ref name="ColorFromGS" ref="ColorFromGS" />
        <fragment_ref name="UVFromGS" ref="UVFromGS" />
    </fragments>
    <connections>
        <connect from="mayaComputeSurfaceFinal.mayaComputeSurfaceFinal" to="mayaSurfaceShaderOutput.mayaSurfaceShaderOutput" name="mayaSurfaceShaderOutput" />
        <connect from="GaussianSplatPixel.GaussianSplatPixel" to="mayaComputeSurfaceFinal.input" name="input" />
        <connect from="ColorFromGS.ColorFromGS" to="GaussianSplatPixel.colorFromGS" name="colorFromGS" />
        <connect from="UVFromGS.UVFromGS" to="GaussianSplatPixel.uvFromGS" name="uvFromGS" />
    </connections>
    <properties>
        <undefined name="GPUStage" ref="GaussianSplatPixel.GPUStage" semantic="GPUStage" />
    </properties>
    <values>
    </values>
    <outputs>
        <struct name="mayaSurfaceShaderOutput" ref="mayaSurfaceShaderOutput.mayaSurfaceShaderOutput" />
    </outputs>
</fragment_graph>
