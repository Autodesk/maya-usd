<!--
Pixel graph of Gaussian splats with a color transform between the geometry color and the
Gaussian falloff: ColorFromGS -> GaussianSplatColorRgb -> OCIOTransform -> GaussianSplatColorRgba
-> GaussianSplatPixel.colorFromGS. The geometry stage writes a straight color, so the transform
acts on it directly, and the pixel stage premultiplies. GaussianSplatColorRgba also reads
ColorFromGS, for its alpha.

This is a template, not a registrable graph: the tokens below are replaced with the graph name
and with the OCIO fragment, input and output that Maya returns for the source color space, then
the result is registered with addFragmentGraphFromBuffer.
-->
<fragment_graph name="@GRAPH_NAME@" ref="@GRAPH_NAME@" class="FragmentGraph" version="1.0" feature_level="0" >
    <fragments>
        <fragment_ref name="mayaSurfaceShaderOutput" ref="mayaSurfaceShaderOutput" />
        <fragment_ref name="mayaComputeSurfaceFinal" ref="mayaComputeSurfaceFinal" />
        <fragment_ref name="GaussianSplatPixel" ref="GaussianSplatPixel" />
        <fragment_ref name="ColorFromGS" ref="ColorFromGS" />
        <fragment_ref name="UVFromGS" ref="UVFromGS" />
        <fragment_ref name="GaussianSplatColorRgb" ref="GaussianSplatColorRgb" />
        <fragment_ref name="GaussianSplatColorRgba" ref="GaussianSplatColorRgba" />
        <fragment_ref name="OCIOTransform" ref="@OCIO_FRAGMENT@" />
    </fragments>
    <connections>
        <connect from="mayaComputeSurfaceFinal.mayaComputeSurfaceFinal" to="mayaSurfaceShaderOutput.mayaSurfaceShaderOutput" name="mayaSurfaceShaderOutput" />
        <connect from="GaussianSplatPixel.GaussianSplatPixel" to="mayaComputeSurfaceFinal.input" name="input" />
        <connect from="ColorFromGS.ColorFromGS" to="GaussianSplatColorRgb.color" name="color" />
        <connect from="GaussianSplatColorRgb.output" to="OCIOTransform.@OCIO_INPUT@" name="@OCIO_INPUT@" />
        <connect from="OCIOTransform.@OCIO_OUTPUT@" to="GaussianSplatColorRgba.transformed" name="transformed" />
        <connect from="ColorFromGS.ColorFromGS" to="GaussianSplatColorRgba.original" name="original" />
        <connect from="GaussianSplatColorRgba.output" to="GaussianSplatPixel.colorFromGS" name="colorFromGS" />
        <connect from="UVFromGS.UVFromGS" to="GaussianSplatPixel.uvFromGS" name="uvFromGS" />
    </connections>
    <properties>
        <undefined name="GPUStage" ref="GaussianSplatPixel.GPUStage" semantic="GPUStage" />
    </properties>
    <values>
    </values>
    <outputs>
        <struct name="mayaSurfaceShaderOutput" ref="mayaSurfaceShaderOutput.mayaSurfaceShaderOutput" />
    </outputs>
</fragment_graph>
