#usda 1.0
(
    defaultPrim = "Top"
    subLayers = [
        @./sub.usda@,
        @./anim.usda@ (offset = 10; scale = 2),
        @./anim48.usda@
    ]
    timeCodesPerSecond = 24
)

def Xform "Top"
{
    def Cube "Cube1"
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double sharedAttr = 10
        double removable = 7
        double blockable = 8
        asset texFile = @./textures/tex.png@
        asset searchTex = @textures/tex.png@
        rel explicitTargets = </Top/Cylinder1>
        prepend rel prependedTargets = </Top/Cylinder1>
    }

    def Cylinder "Cylinder1" (
        customData = {
            dictionary nested = {
                int x = 1
            }
        }
    )
    {
        double radius = 1
    }

    def Cone "Cone1" (
        variants = {
            string size = "small"
        }
        prepend variantSets = ["size", "color"]
    )
    {
        variantSet "color" = {
            "blue" {
                double colorValue = 2
            }
            "red" {
                double colorValue = 1
            }
        }
        variantSet "size" = {
            "big" {
                double radius = 4
            }
            "small" {
                double radius = 1
            }
        }
    }

    def Xform "Ref" (
        prepend references = @./asset.usda@
    )
    {
    }

    over "DefinedInSub"
    {
        double x = 1
    }

    def Camera "Camera1"
    {
        float focalLength = 50
    }
}
