#usda 1.0
(
    defaultPrim = "Geo"
)

def Xform "Geo"
{
    def Cube "CrossRootCube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/SharedMaterial>
    }

    def Cube "LocalCube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Geo/LocalMaterial>
    }

    def Material "LocalMaterial"
    {
    }

    def Xform "ProtoInstance" (
        prepend references = </Prototypes/Proto>
    )
    {
    }
}

def Scope "Prototypes"
{
    def Xform "Proto"
    {
        def Cube "ProtoCube"
        {
        }
    }
}

def Scope "Materials"
{
    def Material "SharedMaterial"
    {
    }
}
