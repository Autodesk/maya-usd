#usda 1.0
(
    defaultPrim = "root"
)

over "prototypes"
{
    def Xform "cube"
    {
        def Mesh "withoutNormals"
        {
            float3[] extent = [(-1.5, -1.5, -1.5), (1.5, 1.5, 1.5)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
            point3f[] points = [(-1.5, -1.5, 1.5), (1.5, -1.5, 1.5), (-1.5, 1.5, 1.5), (1.5, 1.5, 1.5), (-1.5, 1.5, -1.5), (1.5, 1.5, -1.5), (-1.5, -1.5, -1.5), (1.5, -1.5, -1.5)]
            uniform token subdivisionScheme = "none"
        }
    }
}


def Xform "root"
{
    def Xform "cube_01" (
        instanceable = true
        prepend references = </prototypes/cube>
    )
    {
        color3f[] primvars:displayColor = [(1, 0, 0)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (-4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "cube_02" (
        instanceable = true
        prepend references = </prototypes/cube>
    )
    {
        color3f[] primvars:displayColor = [(0, 1, 0)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "cube_03" (
        instanceable = true
        prepend references = </prototypes/cube>
    )
    {
        color3f[] primvars:displayColor = [(0, 0, 1)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

