#usda 1.0

over "root" (
    prepend variantSets = "variant_set_1"
)
{
    def Scope "mtl"
    {
    }
    variantSet "variant_set_1" = {
        "pPlane1" {
            over "mtl" (
                add references = @./variant_set_1_pPlane1.usda@
            )
            {
            }

        }
        "pPlane2" {
            over "mtl" (
                add references = @./variant_set_1_pPlane2.usda@
            )
            {
            }

        }
        "pPlane3" {
            over "mtl" (
                add references = @./variant_set_1_pPlane3.usda@
            )
            {
            }

        }
    }
}

