                    string input_path_regex = "^(/root)/geo/.*"
                    string target_layer_regex = ".*/stage_3530/geo/{variant_payload_selection}.usda"
                    string[] target_path_replace = [""]
                }
                dictionary rule_3 = {
                    string color = "#D08B3C"
                    string description = "Materials to the variant payload for materials."
                    string id = "rule_3"
                    string input_path_regex = "^(/root)/mtl/.*"
                    string target_layer_regex = ".*/stage_3530/mtl/{variant_payload_selection}.usda"
                    string[] target_path_replace = [""]
                }
            }
            int version = 1
        }
    }
    defaultPrim = "root"
    metersPerUnit = 0.01
    upAxis = "Y"
)

class "__class__"
{
    class "stage_3530"
    {
    }
}

